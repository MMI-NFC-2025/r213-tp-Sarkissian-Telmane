---
import { getImageUrl } from "../js/backend.mjs";
import { Image } from "astro:assets";

const {
    record,
    recordImage,
    width = 200, // valeur par défaut
    height = 500, // valeur par défaut
} = Astro.props;

const imageURL = await getImageUrl(record, recordImage);
console.log({ imageURL, recordImage, record });
---

{
    imageURL && (
        <Image
            src={imageURL}
            alt={record.nomMaison || "Image"}
            inferSize={true}
            width={width}
            height={height}
        />
    )
}
