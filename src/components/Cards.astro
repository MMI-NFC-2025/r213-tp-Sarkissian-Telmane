---
const { offres } = Astro.props;
import PbImage from "./PbImage.astro";
---

<div
    class="offre bg-amber-700 w-125 m-4 rounded-2xl flex items-center flex-col"
    data-favori={offres.favori.toString()}
>
    <PbImage record={offres} recordImage={offres.images[0]} />
    <h2 class="font-bold text-2xl">{offres.nomMaison}</h2>
    <!-- <p>{offres.adresse}</p>
    <p>{offres.nbChambres}</p>
    <p>{offres.prix} $$$</p>
    <p>{offres.favori}</p> -->
    <a href={`/offres/${offres.id}`}>Voir plus</a>
</div>
