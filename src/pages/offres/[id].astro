---
import PbImage from "../../components/PbImage.astro";
import { getOffre } from "../../js/backend.mjs";
import Layout from "../../layouts/Layout.astro";

const { id } = Astro.params;
const offre = await getOffre(id);

console.log({ id, offre });
---

<Layout titre={offre.nomMaison}>
    <h2>{offre.nomMaison}</h2>
    <ul>
        <li>Adresse : {offre.adresse}</li>
        <li>Prix adéquat : {offre.prix}</li>
        <li>Chambres : {offre.nbChambres}</li>
        <li>Surface surfacique adéquat : {offre.surface}</li>
    </ul>
</Layout>
