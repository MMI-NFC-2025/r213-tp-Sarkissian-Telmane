---
import { getAllAgents } from "../../js/backend.mjs";
import Layout from "../../layouts/Layout.astro";
const agents = await getAllAgents();
---

<Layout>
    <h1>Nos agents</h1>

    <ul class="space-y-4">
        {
            agents.map((agent) => (
                <li class="offre bg-amber-700 w-125 m-4 rounded-2xl flex items-center flex-col">
                    <h3 class="text-lg font-semibold">
                        {agent.nom} {agent.prenom}
                    </h3>
                    <p>Email : {agent.email}</p>
                </li>
            ))
        }
    </ul>
</Layout>
